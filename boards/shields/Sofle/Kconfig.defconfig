if SHIELD_SOFLE_L_NATIVE

config ZMK_KEYBOARD_NAME
    default "Sofle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_SOFLE_L_NATIVE || SHIELD_SOFLE_R_NATIVE

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_BITS_PER_PIXEL
    default 1

# Correct VDB size for this panel's resolution (128x32).
config LV_Z_VDB_SIZE
    default 64

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif

# Both halves use their own status screen: left = custom_status_screen.c
# (battery of both halves), right = peripheral_status_screen.c (battery/link
# bar + Hammerbeam art). Mirrors what the built-in screen would enable.
if (SHIELD_SOFLE_L_NATIVE || SHIELD_SOFLE_R_NATIVE) && ZMK_DISPLAY

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config LV_Z_MEM_POOL_SIZE
    default 4096

config LV_USE_THEME_MONO
    default y

config LV_FONT_MONTSERRAT_16
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_16
endchoice

endif

if SHIELD_SOFLE_R_NATIVE && ZMK_DISPLAY

config LV_FONT_UNSCII_8
    default y

config LV_USE_LABEL
    default y

config LV_USE_IMG
    default y

endif
